# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# HitPay (may go unused)
HITPAY_API_KEY=
HITPAY_SALT=
HITPAY_WEBHOOK_SECRET=

# Google Sheet mirror. Server-only. Never commit real values.
# GOOGLE_SERVICE_ACCOUNT_JSON is the downloaded key file, minified to one line.
# Share the Sheet with that JSON's client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
# Bearer token for POST /api/export (rewrites the Sheet from Supabase).
EXPORT_SECRET=

# Booking-copy email. Resend delivers the message when someone clicks Send.
# Resend can only send from a domain verified in the Resend account.
# Default in code is the PA Dover Graduation mailbox.
RESEND_API_KEY=
BOOKING_EMAIL_FROM=

# Shared password for /admin. Server-only. Add the same value on Vercel, then redeploy.
ADMIN_PASSWORD=
